+  </div>
+
+</div>
+
+<style>
+  .lbl-f { @apply text-xs font-semibold uppercase tracking-wider text-metfraa-gray-500 block mb-1; }
+  .inp  { @apply w-full text-sm rounded-lg border-metfraa-gray-300 focus:border-metfraa-blue focus:ring-metfraa-blue; }
+</style>
+
+<script>
+function maintApp() {
+  return {
+    tab: 'assets',
+    assets: [],
+    meta: { types: [], locations: [], team: [] },
+    q: '', fLocation: '', fType: '', activeOnly: false,
+    modal: false, saving: false,
+    form: {},
+
+    async init() {
+      await this.loadMeta();
+      await this.loadAssets();
+    },
+    async loadMeta() {
+      const r = await fetch('/maint/api/meta');
+      if (r.ok) this.meta = await r.json();
+    },
+    async loadAssets() {
+      const r = await fetch('/maint/api/assets');
+      if (r.ok) this.assets = await r.json();
+    },
+    get filtered() {
+      const q = this.q.trim().toLowerCase();
+      return this.assets.filter(a => {
+        if (this.activeOnly && !a.active) return false;
+        if (this.fLocation && a.location !== this.fLocation) return false;
+        if (this.fType && String(a.type_id) !== String(this.fType)) return false;
+        if (q) {
+          const hay = [a.asset_code, a.description, a.serial_model_no, a.manufacturer]
+            .filter(Boolean).join(' ').toLowerCase();
+          if (!hay.includes(q)) return false;
+        }
+        return true;
+      });
+    },
+    blank() {
+      return { id: null, asset_code: '', description: '', category: '', type_id: null,
+               serial_model_no: '', manufacturer: '', location: '', acquisition_date: '',
+               acquisition_value: null, capacity: null, capacity_unit: '', mfg_year: null,
+               supplier: '', warranty_until: '', date_installed: '', active: true };
+    },
+    openNew() { this.form = this.blank(); this.modal = true; },
+    openEdit(a) {
+      this.form = {
+        id: a.id, asset_code: a.asset_code, description: a.description,
+        category: a.category || '', type_id: a.type_id,
+        serial_model_no: a.serial_model_no || '', manufacturer: a.manufacturer || '',
+        location: a.location || '', acquisition_date: a.acquisition_date || '',
+        acquisition_value: a.acquisition_value, capacity: a.capacity,
+        capacity_unit: a.capacity_unit || '', mfg_year: a.mfg_year,
+        supplier: a.supplier || '', warranty_until: a.warranty_until || '',
+        date_installed: a.date_installed || '', active: a.active,
+      };
+      this.modal = true;
+    },
+    async save() {
+      if (!this.form.asset_code || !this.form.asset_code.trim()) { toast('Asset code is required', 'error'); return; }
+      if (!this.form.description || !this.form.description.trim()) { toast('Description is required', 'error'); return; }
+      this.saving = true;
+      try {
+        const payload = { ...this.form };
+        ['acquisition_date','warranty_until','date_installed'].forEach(k => { if (!payload[k]) payload[k] = null; });
+        if (payload.category === '') payload.category = null;
+        if (payload.location === '') payload.location = null;
+        const url = this.form.id ? `/maint/api/assets/${this.form.id}` : '/maint/api/assets';
+        const method = this.form.id ? 'PUT' : 'POST';
+        const res = await fetch(url, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
+        const data = await res.json();
+        if (!res.ok) throw new Error(data.detail || 'Save failed');
+        toast(this.form.id ? 'Asset updated' : 'Asset added', 'success');
+        this.modal = false;
+        await this.loadAssets();
+        await this.loadMeta();
+      } catch (e) {
+        toast(e.message, 'error');
+      } finally {
+        this.saving = false;
+      }
+    },
+    async toggle(a) {
+      try {
+        const res = await fetch(`/maint/api/assets/${a.id}/toggle`, { method: 'POST' });
+        const data = await res.json();
+        if (!res.ok) throw new Error(data.detail || 'Failed');
+        a.active = data.active;
+      } catch (e) { toast(e.message, 'error'); }
+    },
+  };
+}
+</script>
+{% endblock %}
