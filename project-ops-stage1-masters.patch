+          <div><label class="lbl block mb-1">Part mark</label><input x-model="form.mark" class="w-full rounded-lg border-metfraa-gray-300 text-sm"></div>
+          <div><label class="lbl block mb-1">Description</label><input x-model="form.description" class="w-full rounded-lg border-metfraa-gray-300 text-sm"></div>
+          <label class="flex items-center gap-2 text-sm"><input type="checkbox" x-model="form.active" class="rounded border-metfraa-gray-300"> Active</label>
+          <button @click="save('part-marks')" class="w-full py-2.5 rounded-lg bg-metfraa-blue text-white text-sm font-bold">Save</button>
+        </div>
+      </template>
+
+      <template x-if="drawer === 'equip'">
+        <div class="space-y-4">
+          <div><label class="lbl block mb-1">Equipment name</label><input x-model="form.name" class="w-full rounded-lg border-metfraa-gray-300 text-sm"></div>
+          <label class="flex items-center gap-2 text-sm"><input type="checkbox" x-model="form.active" class="rounded border-metfraa-gray-300"> Active</label>
+          <button @click="save('equipment')" class="w-full py-2.5 rounded-lg bg-metfraa-blue text-white text-sm font-bold">Save</button>
+        </div>
+      </template>
+    </div>
+  </div>
+</div>
+
+<script>
+function projOps() {
+  return {
+    tab: 'master', masterTab: 'sites',
+    sites: [], types: [], contractors: [], parts: [], equipment: [],
+    partFilterSite: null, rateRows: [],
+    showInactive: { sites: false },
+    drawer: null, drawerTitle: '', form: {},
+
+    tabs: [{ id: 'master', label: 'Master' }],
+
+    init() { this.loadSites(); this.loadSitesForDropdowns(); },
+    onTab() { if (this.tab === 'master') this.onMasterTab(); },
+    onMasterTab() {
+      if (this.masterTab === 'sites') this.loadSites();
+      if (this.masterTab === 'types') this.loadTypes();
+      if (this.masterTab === 'contractors') this.loadContractors();
+      if (this.masterTab === 'parts') { this.loadSitesForDropdowns(); this.loadParts(); }
+      if (this.masterTab === 'equipment') this.loadEquipment();
+    },
+
+    async _get(path) { const r = await fetch(path); return r.ok ? r.json() : null; },
+    async loadSites() {
+      const d = await this._get('/project-ops/api/sites?include_inactive=' + (this.showInactive.sites ? 1 : 0));
+      if (d) { this.sites = d.sites; }
+    },
+    async loadSitesForDropdowns() {
+      const d = await this._get('/project-ops/api/sites'); if (d) this.sites = d.sites;
+    },
+    async loadTypes() { const d = await this._get('/project-ops/api/worker-types'); if (d) this.types = d.worker_types; },
+    async loadContractors() { const d = await this._get('/project-ops/api/contractors'); if (d) this.contractors = d.contractors; },
+    async loadParts() {
+      const q = this.partFilterSite ? ('?site_id=' + this.partFilterSite) : '';
+      const d = await this._get('/project-ops/api/part-marks' + q); if (d) this.parts = d.part_marks;
+    },
+    async loadEquipment() { const d = await this._get('/project-ops/api/equipment'); if (d) this.equipment = d.equipment; },
+
+    editSite(s) { this.form = s ? {...s} : { job_id: '', name: '', active: true }; this.drawer = 'site'; this.drawerTitle = s ? 'Edit site' : 'Add site'; },
+    editType(w) { this.form = w ? {...w} : { name: '', rate_per_hour: 0, active: true }; this.drawer = 'type'; this.drawerTitle = w ? 'Edit worker type' : 'Add worker type'; },
+    editPart(p) { this.form = p ? {...p} : { site_id: this.partFilterSite || null, mark: '', description: '', active: true }; this.drawer = 'part'; this.drawerTitle = p ? 'Edit part mark' : 'Add part mark'; },
+    editEquip(e) { this.form = e ? {...e} : { name: '', active: true }; this.drawer = 'equip'; this.drawerTitle = e ? 'Edit equipment' : 'Add equipment'; },
+    async editContractor(c) {
+      this.form = c ? {...c} : { name: '', standard_hours: 8, active: true };
+      this.drawer = 'contractor'; this.drawerTitle = c ? 'Edit contractor' : 'Add contractor';
+      if (c) {
+        const d = await this._get('/project-ops/api/contractors/' + c.id + '/rates');
+        this.rateRows = d ? d.rows.map(r => ({...r, override: r.override ?? ''})) : [];
+      } else {
+        const d = await this._get('/project-ops/api/worker-types');
+        this.rateRows = d ? d.worker_types.map(t => ({ worker_type_id: t.id, name: t.name, default_rate: t.rate_per_hour, override: '' })) : [];
+      }
+    },
+
+    async save(path) {
+      const r = await fetch('/project-ops/api/' + path, {
+        method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(this.form),
+      });
+      if (!r.ok) { const d = await r.json().catch(()=>({})); alert(d.detail || 'Failed'); return; }
+      this.drawer = null; this.onMasterTab();
+    },
+    async saveContractor() {
+      const overrides = {};
+      this.rateRows.forEach(r => { overrides[r.worker_type_id] = (r.override === '' || r.override == null) ? null : +r.override; });
+      const r = await fetch('/project-ops/api/contractors', {
+        method: 'POST', headers: {'Content-Type':'application/json'},
+        body: JSON.stringify({ ...this.form, overrides }),
+      });
+      if (!r.ok) { const d = await r.json().catch(()=>({})); alert(d.detail || 'Failed'); return; }
+      this.drawer = null; this.loadContractors();
+    },
+    async delRow(path, row) {
+      if (!confirm('Remove ' + (row.name || row.mark) + '?')) return;
+      const r = await fetch('/project-ops/api/' + path + '/' + row.id, { method: 'DELETE' });
+      if (!r.ok) { alert('Failed'); return; }
+      this.onMasterTab();
+    },
+  };
+}
+</script>
+{% endblock %}
