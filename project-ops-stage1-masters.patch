+    rate_per_hour = Column(Float, nullable=False, default=0)
+    __table_args__ = (UniqueConstraint("contractor_id", "worker_type_id",
+                                       name="uq_proj_contractor_rate"),)
+
+
+class ProjPartMark(Base):
