+}
+.trip-total .label { font-size: 12px; opacity: 0.7; }
+.trip-total .value { font-size: 20px; font-weight: 600; font-variant-numeric: tabular-nums; }
+
+.add-trip-btn {
+  width: 100%;
+  background: var(--bsg-card);
+  border: 2px dashed var(--bsg-blue);
+  color: var(--bsg-blue);
