+                       + (r.advance_hr_verified_count || 0)
+                       + (r.advance_mgmt_approved_count || 0)
+                       + (r.advance_approved_count || 0);
+      const rejectedInMonth = r.rejected_count || 0;
+      const approvedLike = (r.approved_count || 0) + (r.settled_count || 0);
