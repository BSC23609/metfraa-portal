+}
+.vd-diff {
+  margin-top: 12px; padding: 9px 12px; border-radius: 3px;
+  font-size: 13px; font-weight: 500;
+}
+.vd-diff.balanced  { background: rgba(5,150,105,0.10);  color: var(--bsg-success); }
