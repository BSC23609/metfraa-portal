+}
+.field textarea { resize: vertical; min-height: 70px; font-family: inherit; }
+.field input[type=number] { font-variant-numeric: tabular-nums; }
+.field input[readonly], .field input.locked {
+  background: var(--bsg-soft);
+  color: var(--bsg-muted);
+  cursor: not-allowed;
+}
+
+/* Trip blocks */
+.trip-block {
+  border: 1px solid var(--bsg-line);
+  border-left: 3px solid var(--bsg-blue);
