+.adv-amt { text-align: right; display: flex; flex-direction: column; align-items: flex-end; }
+.adv-amt-lbl { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--bsg-muted); }
+.adv-amt-val { font-family: 'Oswald', sans-serif; font-size: 18px; color: var(--bsg-blue); font-weight: 600; }
+.adv-purpose { font-size: 13px; color: var(--bsg-ink); margin: 12px 0; padding: 10px 12px; background: var(--bsg-soft, #f6f8fa); border-radius: 3px; }
+.adv-row-foot { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-top: 8px; }
+
+/* ---- Settlement difference banner ------------------------------ */
+.settle-diff {
