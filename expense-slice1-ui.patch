+}
+
+/* ---- Dashboard ------------------------------------------------ */
+.dash-toolbar {
+  display: flex; align-items: center; gap: 14px;
+  flex-wrap: wrap; margin-bottom: 18px;
+}
+.dash-range {
+  display: flex; align-items: center; gap: 8px;
+}
+.dash-range label {
