+}
+.card .card-title::before {
+  content: '';
+  width: 4px;
+  height: 16px;
+  background: var(--bsg-blue);
+}
+
+.entitlement-banner {
+  background: linear-gradient(135deg, rgba(31,124,203,0.08), rgba(31,124,203,0.02));
+  border: 1px solid rgba(31,124,203,0.2);
