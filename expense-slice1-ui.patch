+.settle-diff.to-return { background: rgba(180,83,9,0.08);   border-left: 3px solid var(--bsg-warning); color: var(--bsg-warning); }
+.settle-diff.to-claim  { background: rgba(37,99,235,0.08);  border-left: 3px solid var(--bsg-blue);    color: var(--bsg-blue); }
+
+.admin-actions button.view:hover     { background: var(--bsg-ink);     color: white; border-color: var(--bsg-ink); }
+.admin-actions button.approve:hover  { background: var(--bsg-success); color: white; border-color: var(--bsg-success); }
+.admin-actions button.reject:hover   { background: var(--bsg-danger);  color: white; border-color: var(--bsg-danger); }
