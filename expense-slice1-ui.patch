+}
+
+/* ===================================================================
+   FILE UPLOAD SECTION
+   =================================================================== */
+.upload-zone {
+  border: 2px dashed var(--bsg-line);
+  border-radius: 4px;
+  padding: 32px 24px;
+  text-align: center;
+  cursor: pointer;
+  transition: all 0.2s ease;
+  background: var(--bsg-soft);
+}
+.upload-zone:hover, .upload-zone.dragover {
+  border-color: var(--bsg-blue);
+  background: rgba(31,124,203,0.04);
+  color: var(--bsg-blue);
+}
+.upload-zone .icon {
+  font-size: 32px;
+  margin-bottom: 10px;
+  display: block;
+}
+.upload-zone .text {
+  font-family: 'Oswald', sans-serif;
+  font-size: 14px;
+  letter-spacing: 0.1em;
+  text-transform: uppercase;
+  color: var(--bsg-ink);
+  margin-bottom: 4px;
+}
+.upload-zone .hint {
+  font-size: 12px;
