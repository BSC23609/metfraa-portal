+
+/* ===================================================================
+   VALIDATION / TOAST / MODAL
+   =================================================================== */
+.field.error input, .field.error select, .field.error textarea {
+  border-color: var(--bsg-danger);
+  background: rgba(220,38,38,0.03);
+}
+.row.error input { border-color: var(--bsg-danger); }
+
+.toast {
+  position: fixed;
+  top: 100px;
+  right: 32px;
+  background: var(--bsg-ink);
+  color: white;
+  padding: 14px 22px;
+  border-radius: 3px;
+  border-left: 3px solid var(--bsg-blue);
+  box-shadow: var(--shadow-lg);
+  z-index: 200;
+  font-size: 14px;
+  transform: translateX(120%);
+  transition: transform 0.3s ease;
+  max-width: 340px;
+}
+.toast.show { transform: translateX(0); }
+.toast.error { border-left-color: var(--bsg-danger); }
+.toast.success { border-left-color: var(--bsg-success); }
+.toast.warning { border-left-color: var(--bsg-warning); }
+
+.modal-backdrop {
+  position: fixed;
+  inset: 0;
+  background: rgba(13,20,33,0.5);
+  backdrop-filter: blur(4px);
+  z-index: 300;
+  display: none;
+  align-items: center;
+  justify-content: center;
+  padding: 20px;
+}
+.modal-backdrop.show { display: flex; }
+.modal {
+  background: white;
+  border-radius: 4px;
+  max-width: 480px;
+  width: 100%;
+  padding: 32px;
+  box-shadow: var(--shadow-xl);
+  border-top: 4px solid var(--bsg-blue);
+}
+.modal h3 {
+  font-family: 'Oswald', sans-serif;
+  font-size: 22px;
+  text-transform: uppercase;
+  color: var(--bsg-ink);
