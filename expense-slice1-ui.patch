+  border-radius: 4px; margin-bottom: 16px;
+}
+.vd-total span { font-family: 'Oswald', sans-serif; letter-spacing: 0.08em; text-transform: uppercase; font-size: 13px; }
+.vd-total strong { font-size: 20px; }
+.vd-attachments { margin-top: 6px; }
+.vd-chip {
+  display: inline-block; background: var(--bsg-soft, #f0f3f6);
+  border: 1px solid var(--bsg-line); border-radius: 3px;
