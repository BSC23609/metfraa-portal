+}
+.vd-value { font-size: 14px; color: var(--bsg-ink); word-break: break-word; }
+.vd-review {
+  background: rgba(5,150,105,0.08); border-left: 3px solid var(--bsg-success);
+  color: var(--bsg-success); padding: 9px 12px; border-radius: 3px;
+  font-size: 12.5px; margin-bottom: 16px;
+}
+.vd-table { width: 100%; border-collapse: collapse; margin-bottom: 16px; }
+.vd-table th {
+  background: var(--bsg-ink); color: #fff; font-family: 'Oswald', sans-serif;
+  font-size: 11px; letter-spacing: 0.05em; text-transform: uppercase;
+  padding: 8px 10px; text-align: left;
+}
+.vd-table td { padding: 8px 10px; border-bottom: 1px solid var(--bsg-line); font-size: 13px; }
+.vd-table td.num, .vd-table th.num { text-align: right; }
+.vd-table tr:nth-child(even) td { background: var(--bsg-soft, #f6f8fa); }
+.vd-total {
+  display: flex; align-items: center; justify-content: space-between;
