+.topbar-back:hover {
+  background: var(--bsg-ink);
+  color: #fff;
+  border-color: var(--bsg-ink);
+  transform: translateX(-2px);
+}
+
+/* ===================================================================
+   SUBMISSION VIEWER MODAL
+   =================================================================== */
+.modal-wide { max-width: 760px; width: 92vw; }
+.view-modal-head {
+  display: flex; align-items: flex-start; justify-content: space-between;
+  gap: 16px; margin-bottom: 18px; padding-bottom: 14px;
+  border-bottom: 1px solid var(--bsg-line);
+}
+.view-modal-ref {
+  font-family: 'JetBrains Mono', monospace; font-size: 11px;
+  color: var(--bsg-muted); letter-spacing: 0.04em;
+}
+.view-modal-body { max-height: 60vh; overflow-y: auto; }
+.vd-grid {
+  display: grid; grid-template-columns: repeat(3, 1fr);
+  gap: 14px 20px; margin-bottom: 18px;
+}
+.vd-cell { min-width: 0; }
+.vd-label {
+  font-family: 'JetBrains Mono', monospace; font-size: 10px;
+  letter-spacing: 0.08em; text-transform: uppercase; color: var(--bsg-muted);
