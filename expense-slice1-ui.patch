+}
+.row input[readonly] { background: #f8fafc; color: var(--bsg-muted); }
+.row .x-btn {
+  width: 32px;
+  height: 32px;
+  background: transparent;
+  border: 1px solid var(--bsg-line);
+  color: var(--bsg-muted);
+  border-radius: 2px;
+  cursor: pointer;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  transition: all 0.2s ease;
+}
+.row .x-btn:hover { background: var(--bsg-danger); color: white; border-color: var(--bsg-danger); }
+
+.col-header {
+  display: grid;
+  gap: 8px;
+  padding: 0 4px 8px;
+  font-family: 'JetBrains Mono', monospace;
+  font-size: 10px;
+  letter-spacing: 0.12em;
+  color: var(--bsg-muted);
+  text-transform: uppercase;
+}
+
+/* Per-form row column templates */
+.row-conv      { grid-template-columns: 110px 1.1fr 1.1fr 1fr 70px 110px 36px; }
+.col-conv      { grid-template-columns: 110px 1.1fr 1.1fr 1fr 70px 110px 36px; }
+.row-cab       { grid-template-columns: 110px 1fr 1fr 90px 90px 1.1fr 36px; }
+.col-cab       { grid-template-columns: 110px 1fr 1fr 90px 90px 1.1fr 36px; }
+.row-acc       { grid-template-columns: 110px 1fr 1fr 100px 100px 36px; }
+.col-acc       { grid-template-columns: 110px 1fr 1fr 100px 100px 36px; }
+.row-exp       { grid-template-columns: 110px 1fr 110px 36px; }
+.col-exp       { grid-template-columns: 110px 1fr 110px 36px; }
+.row-misc      { grid-template-columns: 130px 1fr 130px 36px; }
+.col-misc      { grid-template-columns: 130px 1fr 130px 36px; }
+/* inline per-row warnings span the whole row width */
+.row .od-warn  { grid-column: 1 / -1; }
+
+.add-row-btn {
+  background: transparent;
+  border: 1px dashed var(--bsg-line);
+  color: var(--bsg-muted);
+  padding: 9px 14px;
+  font-family: 'JetBrains Mono', monospace;
+  font-size: 11px;
