+
+  function drawConsolidatedTable() {
+    const tbody = $('#conTableBody');
+    if (!tbody) return;
+    const rows = (state.monthlyWrapup && state.monthlyWrapup.rows) || [];
+    const period = (state.monthlyWrapup && state.monthlyWrapup.period) || '';
