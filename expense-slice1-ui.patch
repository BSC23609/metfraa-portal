+}
+.modal p { color: var(--bsg-muted); line-height: 1.6; margin-bottom: 12px; font-size: 14px; }
+.modal .modal-recipient {
+  background: var(--bsg-soft);
+  padding: 12px 16px;
+  border-radius: 3px;
+  font-family: 'JetBrains Mono', monospace;
+  font-size: 13px;
+  color: var(--bsg-ink);
+  margin: 16px 0;
+  word-break: break-all;
+}
+.modal .actions {
+  margin-top: 24px;
+  display: flex;
+  gap: 12px;
+  justify-content: flex-end;
+}
+
+/* Loading overlay */
+.loading-overlay {
+  position: fixed;
+  inset: 0;
+  background: rgba(13,20,33,0.7);
+  backdrop-filter: blur(6px);
+  z-index: 400;
+  display: none;
+  align-items: center;
+  justify-content: center;
+  color: white;
+  flex-direction: column;
+  gap: 18px;
+}
+.loading-overlay.show { display: flex; }
+.loading-overlay .spinner {
+  width: 56px;
+  height: 56px;
+  border: 4px solid rgba(255,255,255,0.2);
+  border-top-color: white;
+  border-radius: 50%;
+  animation: spin 0.9s linear infinite;
+}
+.loading-overlay .text {
+  font-family: 'Oswald', sans-serif;
+  font-size: 16px;
+  letter-spacing: 0.15em;
+  text-transform: uppercase;
+}
+@keyframes spin { to { transform: rotate(360deg); } }
+
+/* ===================================================================
+   RESPONSIVE
+   =================================================================== */
+@media (max-width: 900px) {
+  .row-conv, .col-conv { grid-template-columns: 1fr 1fr; }
+  .row-cab, .col-cab { grid-template-columns: 1fr 1fr; }
+  .row-acc, .col-acc { grid-template-columns: 1fr 1fr; }
+  .col-header { display: none; }
+}
+@media (max-width: 768px) {
+  .container { padding: 24px 16px 60px; }
+  .topbar { padding: 0 16px; height: 64px; }
+  .topbar img.logo { height: 36px; }
+  .topbar img.logo.company { height: 30px; }
+  .topbar-tag { display: none; }
+  .field-grid, .field-grid.three { grid-template-columns: 1fr; }
+  .field.span-2 { grid-column: span 1; }
+  .hub-header h2 { font-size: 30px; }
+  .row-exp, .col-exp { grid-template-columns: 1fr 1fr; }
+  .row .x-btn { grid-column: 2; justify-self: end; }
+  .report { padding: 24px 18px; }
+  .report .employee-info { grid-template-columns: 1fr 1fr; }
+  .report .employee-info .cell:nth-child(4n) { border-right: 1px solid var(--bsg-line); }
+  .report .employee-info .cell:nth-child(2n) { border-right: none; }
+  .report .trip-meta { grid-template-columns: 1fr; }
+  .summary-bar { flex-direction: column; align-items: flex-start; gap: 12px; }
+  .summary-bar .count { text-align: left; }
+  .policy-doc { padding: 24px 20px; }
+}
+
+/* ===================================================================
+   PRINT
+   =================================================================== */
+@media print {
+  body::before, body::after { display: none; }
+  .topbar, .report-toolbar, .action-bar, .toast, .loading-overlay { display: none !important; }
+  .container { padding: 0; max-width: none; }
+  .report { box-shadow: none; border: none; padding: 0; }
+}
