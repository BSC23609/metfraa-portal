diff --git a/app/static/expense/css/app.css b/app/static/expense/css/app.css
new file mode 100644
index 0000000..aebd942
--- /dev/null
+++ b/app/static/expense/css/app.css
@@ -0,0 +1,2252 @@
+/* ====================================================================
+   BHARAT STEEL GROUP · DESIGN SYSTEM
+   ==================================================================== */
+
+:root {
+  --bsg-blue:       #1F7CCB;
+  --bsg-blue-dark:  #155a96;
+  --bsg-blue-light: #4a9fe0;
+  --bsg-ink:        #0d1421;
+  --bsg-charcoal:   #1a2332;
+  --bsg-steel:      #2a3548;
+  --bsg-line:       #d6dde6;
+  --bsg-page:       #f4f6f9;
+  --bsg-card:       #ffffff;
+  --bsg-text:       #1a2332;
+  --bsg-muted:      #6b7689;
+  --bsg-soft:       #eef2f7;
+  --bsg-accent:     #f59e0b;
+  --bsg-danger:     #dc2626;
+  --bsg-warning:    #b45309;
+  --bsg-success:    #059669;
+  --shadow-sm: 0 1px 2px rgba(13,20,33,0.05);
+  --shadow-md: 0 4px 16px rgba(13,20,33,0.08), 0 1px 3px rgba(13,20,33,0.06);
+  --shadow-lg: 0 20px 50px -10px rgba(13,20,33,0.18), 0 4px 12px rgba(13,20,33,0.08);
+  --shadow-xl: 0 40px 80px -20px rgba(13,20,33,0.30);
+}
+
+* { box-sizing: border-box; margin: 0; padding: 0; }
+
+html, body { height: 100%; }
+
+body {
+  font-family: 'Inter', system-ui, sans-serif;
+  background: var(--bsg-page);
+  color: var(--bsg-text);
+  -webkit-font-smoothing: antialiased;
+  overflow-x: hidden;
+}
+
+/* Industrial steel-grid background */
+body::before {
+  content: '';
+  position: fixed;
+  inset: 0;
+  background-image:
+    linear-gradient(rgba(31, 124, 203, 0.04) 1px, transparent 1px),
+    linear-gradient(90deg, rgba(31, 124, 203, 0.04) 1px, transparent 1px);
+  background-size: 48px 48px;
+  pointer-events: none;
+  z-index: 0;
+}
+
+body::after {
+  content: '';
+  position: fixed;
+  inset: 0;
+  background: radial-gradient(circle at 20% 10%, rgba(31,124,203,0.06), transparent 40%),
+              radial-gradient(circle at 80% 90%, rgba(31,124,203,0.04), transparent 50%);
+  pointer-events: none;
+  z-index: 0;
+}
+
+.app { position: relative; z-index: 1; min-height: 100vh; }
+
+/* ===================================================================
+   TOP BAR
+   =================================================================== */
+.topbar {
+  height: 78px;
+  background: var(--bsg-card);
+  border-bottom: 2px solid var(--bsg-ink);
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: 0 32px;
+  position: sticky;
+  top: 0;
+  z-index: 50;
+  box-shadow: var(--shadow-sm);
+}
+.topbar-left, .topbar-right { display: flex; align-items: center; gap: 14px; }
+.topbar img.logo { height: 46px; width: auto; cursor: pointer; }
+.topbar img.logo.company { height: 42px; }
+.topbar-divider {
+  width: 1px;
+  height: 36px;
+  background: var(--bsg-line);
+  margin: 0 6px;
+}
+.topbar-tag {
+  font-family: 'JetBrains Mono', monospace;
+  font-size: 10px;
+  letter-spacing: 0.18em;
+  text-transform: uppercase;
+  color: var(--bsg-muted);
+  padding: 5px 10px;
+  border: 1px solid var(--bsg-line);
+  border-radius: 3px;
+}
+.user-chip {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  background: var(--bsg-soft);
+  padding: 6px 6px 6px 14px;
+  border-radius: 999px;
+  cursor: pointer;
+  position: relative;
+  transition: background 0.2s ease;
+}
+.user-chip:hover { background: #e3e9f0; }
+.user-chip .name {
+  font-size: 13px;
+  font-weight: 500;
+  color: var(--bsg-ink);
+  max-width: 140px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.user-chip .avatar {
+  width: 28px;
+  height: 28px;
+  border-radius: 50%;
+  background: var(--bsg-ink);
+  color: white;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  font-size: 11px;
+  font-weight: 600;
+  letter-spacing: 0.05em;
+}
+.user-menu {
+  position: absolute;
+  top: calc(100% + 8px);
+  right: 0;
+  background: white;
+  border: 1px solid var(--bsg-line);
+  border-radius: 4px;
+  box-shadow: var(--shadow-lg);
+  min-width: 240px;
+  padding: 12px;
+  display: none;
+  z-index: 60;
+}
+.user-menu.open { display: block; }
+.user-menu .info {
+  padding: 8px 8px 12px;
+  border-bottom: 1px dashed var(--bsg-line);
+  margin-bottom: 8px;
+}
+.user-menu .info .full-name {
+  font-size: 14px;
+  font-weight: 600;
+  color: var(--bsg-ink);
+  margin-bottom: 2px;
+}
+.user-menu .info .email {
+  font-size: 12px;
+  color: var(--bsg-muted);
+  word-break: break-all;
+}
+.user-menu .info .level {
+  display: inline-block;
+  margin-top: 6px;
+  font-family: 'JetBrains Mono', monospace;
+  font-size: 10px;
+  letter-spacing: 0.1em;
+  background: var(--bsg-soft);
+  padding: 3px 8px;
+  border-radius: 2px;
+  color: var(--bsg-ink);
+}
+.user-menu form button {
+  width: 100%;
+  background: transparent;
+  border: 1px solid var(--bsg-line);
+  padding: 9px 12px;
+  font-family: 'JetBrains Mono', monospace;
+  font-size: 11px;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+  cursor: pointer;
+  border-radius: 2px;
+  color: var(--bsg-text);
+  transition: all 0.2s ease;
+}
+.user-menu form button:hover {
+  background: var(--bsg-danger);
+  color: white;
+  border-color: var(--bsg-danger);
+}
+
+/* ===================================================================
+   PAGE BASE
+   =================================================================== */
+.page {
+  display: none;
+  animation: pageIn 0.45s cubic-bezier(0.16, 1, 0.3, 1);
+}
+.page.active { display: block; }
+
+@keyframes pageIn {
+  from { opacity: 0; transform: translateY(10px); }
+  to   { opacity: 1; transform: translateY(0); }
+}
+
+.container {
+  max-width: 1180px;
+  margin: 0 auto;
+  padding: 48px 32px 80px;
+}
+
+/* ===================================================================
+   LANDING (company picker)
+   =================================================================== */
+.landing-wrap {
+  min-height: calc(100vh - 78px);
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  padding: 40px 24px;
+}
+.landing-hero {
+  text-align: center;
+  margin-bottom: 56px;
+}
+.landing-hero .group-logo-wrap img {
+  max-width: 360px;
+  width: 100%;
+  height: auto;
+  filter: drop-shadow(0 8px 24px rgba(31,124,203,0.18));
+}
+.landing-hero .tagline {
+  font-family: 'JetBrains Mono', monospace;
+  font-size: 11px;
+  letter-spacing: 0.3em;
+  color: var(--bsg-muted);
+  text-transform: uppercase;
+  margin-top: 28px;
+}
+
+.company-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(280px, 340px));
+  gap: 28px;
+  justify-content: center;
+  width: 100%;
+  max-width: 760px;
+}
+
+.company-card {
+  background: var(--bsg-card);
+  border: 2px solid var(--bsg-line);
+  border-radius: 6px;
+  padding: 48px 40px;
+  cursor: pointer;
+  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
+  position: relative;
+  overflow: hidden;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  min-height: 180px;
+}
+
+.company-card::before {
+  content: '';
+  position: absolute;
+  top: 0;
+  left: 0;
+  width: 6px;
+  height: 100%;
+  background: var(--bsg-blue);
+  transform: translateX(-100%);
+  transition: transform 0.3s ease;
+}
+
+.company-card:hover {
+  border-color: var(--bsg-ink);
+  transform: translateY(-4px);
+  box-shadow: var(--shadow-lg);
+}
+
+.company-card:hover::before { transform: translateX(0); }
+
+.company-card.disabled {
+  cursor: not-allowed;
+  opacity: 0.4;
+  filter: grayscale(0.8);
+}
+.company-card.disabled:hover { transform: none; box-shadow: none; border-color: var(--bsg-line); }
+.company-card.disabled::before { display: none; }
+
+.company-card .logo-area {
+  max-width: 100%;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+}
+.company-card .logo-area img {
+  max-width: 100%;
+  max-height: 70px;
+  width: auto;
+  height: auto;
+}
+
+.company-card .locked-pill {
+  position: absolute;
+  top: 12px;
+  right: 12px;
+  font-family: 'JetBrains Mono', monospace;
+  font-size: 9px;
+  letter-spacing: 0.15em;
+  color: var(--bsg-muted);
+  background: var(--bsg-soft);
+  padding: 4px 8px;
+  border-radius: 2px;
+  text-transform: uppercase;
+}
+
+/* ===================================================================
+   HUB (form options)
+   =================================================================== */
+.hub-header {
+  display: flex;
+  align-items: flex-end;
+  justify-content: space-between;
+  margin-bottom: 36px;
+  padding-bottom: 24px;
+  border-bottom: 2px solid var(--bsg-ink);
+  flex-wrap: wrap;
+  gap: 20px;
+}
+.hub-header h2 {
+  font-family: 'Oswald', sans-serif;
+  font-weight: 600;
+  font-size: 42px;
+  text-transform: uppercase;
+  color: var(--bsg-ink);
+  line-height: 1;
+}
+
+.option-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
+  gap: 20px;
+  margin-bottom: 32px;
+}
+
+.option-card {
+  background: var(--bsg-card);
+  border: 2px solid var(--bsg-line);
+  border-radius: 4px;
+  padding: 32px 28px;
+  cursor: pointer;
+  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
+  position: relative;
+  overflow: hidden;
+  display: flex;
+  flex-direction: column;
+}
+.option-card:hover {
+  transform: translateY(-4px);
+  border-color: var(--bsg-ink);
+  box-shadow: var(--shadow-lg);
+}
+.option-card .icon-wrap {
+  width: 52px;
+  height: 52px;
+  border-radius: 4px;
+  background: linear-gradient(135deg, var(--bsg-ink), var(--bsg-charcoal));
+  color: white;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  margin-bottom: 22px;
+  transition: all 0.3s ease;
+}
+.option-card:hover .icon-wrap {
+  background: linear-gradient(135deg, var(--bsg-blue), var(--bsg-blue-dark));
+  transform: rotate(-3deg);
+}
+.option-card .icon-wrap svg { width: 26px; height: 26px; }
+
+.option-card h3 {
+  font-family: 'Oswald', sans-serif;
+  font-weight: 600;
+  font-size: 22px;
+  text-transform: uppercase;
+  color: var(--bsg-ink);
