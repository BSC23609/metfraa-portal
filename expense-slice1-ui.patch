+.field label .req { color: var(--bsg-danger); margin-left: 2px; }
+
+.field input, .field select, .field textarea {
+  font-family: 'Inter', sans-serif;
+  font-size: 14px;
+  padding: 11px 14px;
+  border: 1px solid var(--bsg-line);
