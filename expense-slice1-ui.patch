+}
+.vd-chip-ico { display: inline-flex; width: 13px; height: 13px; }
+.vd-chip-ico svg { width: 13px; height: 13px; }
+
+/* Settlement block inside the popup viewer */
+.vd-settlement {
+  margin: 16px 0; padding: 14px 16px;
+  background: var(--bsg-soft, #f6f8fa); border-radius: 4px;
