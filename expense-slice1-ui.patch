+  align-items: center;
+  justify-content: center;
+  flex-shrink: 0;
+}
+.entitlement-banner .info { flex: 1; min-width: 180px; }
+.entitlement-banner .info .label {
+  font-family: 'JetBrains Mono', monospace;
+  font-size: 10px;
+  letter-spacing: 0.15em;
+  color: var(--bsg-blue-dark);
+  text-transform: uppercase;
+  margin-bottom: 2px;
+}
+.entitlement-banner .info .value {
+  font-size: 14px;
+  color: var(--bsg-ink);
+  font-weight: 500;
+}
+.entitlement-banner .info .value strong {
+  font-family: 'Oswald', sans-serif;
+  font-weight: 600;
+  color: var(--bsg-blue-dark);
+}
+
+.field-grid {
+  display: grid;
+  grid-template-columns: repeat(2, 1fr);
+  gap: 18px;
+}
+.field-grid.three { grid-template-columns: repeat(3, 1fr); }
+.field-grid.full { grid-template-columns: 1fr; }
+
+.field { display: flex; flex-direction: column; }
+.field.span-2 { grid-column: span 2; }
+
+.field label {
+  font-family: 'JetBrains Mono', monospace;
+  font-size: 11px;
+  letter-spacing: 0.12em;
+  color: var(--bsg-muted);
