+.dash-tile-val {
+  font-family: 'Oswald', sans-serif;
+  font-size: 26px; color: var(--bsg-ink); font-weight: 600; line-height: 1;
+}
+.dash-tile-sub {
+  font-size: 11px; color: var(--bsg-muted); margin-top: 6px;
+}
+
+/* Chart grid */
+.dash-charts {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 18px;
+}
+.dash-chart-card { padding: 22px; }
+.dash-chart-host {
+  position: relative; height: 320px; width: 100%;
+}
+.dash-chart-wide { grid-column: span 2; }
+@media (max-width: 880px) {
+  .dash-charts { grid-template-columns: 1fr; }
+  .dash-chart-wide { grid-column: auto; }
+}
+
+/* ---- Daily Travel Reimbursement form ------------------------------ */
+.dtr-entries { display: flex; flex-direction: column; gap: 14px; margin-bottom: 14px; }
+.dtr-entry {
+  border-left: 3px solid var(--bsg-blue);
+  padding: 18px 22px;
+}
+.dtr-entry-head {
+  display: flex; align-items: center; justify-content: space-between;
+  margin-bottom: 14px; padding-bottom: 10px; border-bottom: 1px solid var(--bsg-line);
+}
+.dtr-entry-num {
+  font-family: 'JetBrains Mono', monospace;
+  font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase;
+  color: var(--bsg-muted);
+}
+.remove-row-btn {
+  background: transparent; border: 1px solid var(--bsg-line);
+  color: var(--bsg-danger); padding: 5px 12px; border-radius: 3px;
+  font-size: 12px; cursor: pointer;
+}
+.remove-row-btn:hover { background: rgba(220, 38, 38, 0.08); }
+.dtr-purpose-block {
+  margin-top: 12px; padding: 12px 14px;
+  background: #f6f8fa; border-radius: 4px;
+}
+.dtr-purpose-lbl {
+  font-family: 'JetBrains Mono', monospace;
+  font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase;
+  color: var(--bsg-muted); margin-bottom: 10px;
+}
+.dtr-bill-zone {
+  display: flex; align-items: center; gap: 12px;
+  padding: 14px 16px; border: 1.5px dashed var(--bsg-line);
+  border-radius: 4px; cursor: pointer;
+  transition: background 0.15s, border-color 0.15s;
+}
+.dtr-bill-zone:hover {
+  background: rgba(37, 99, 235, 0.04); border-color: var(--bsg-blue);
+}
+.dtr-bill-zone .icon { font-size: 20px; }
+.dtr-bill-zone .text { font-weight: 500; color: var(--bsg-ink); font-size: 13px; }
+.dtr-bill-zone .hint { font-size: 11px; color: var(--bsg-muted); margin-top: 2px; }
+.dtr-bill-attached {
+  display: flex; align-items: center; gap: 10px;
+  padding: 10px 14px; background: rgba(5, 150, 105, 0.08);
+  border-left: 3px solid var(--bsg-success); border-radius: 3px;
+}
+.dtr-bill-attached .fname { flex: 1; font-size: 13px; color: var(--bsg-ink); }
+.dtr-bill-attached .remove {
+  background: transparent; border: 0; color: var(--bsg-muted);
+  font-size: 18px; cursor: pointer; padding: 0 6px;
+}
+.dtr-bill-attached .remove:hover { color: var(--bsg-danger); }
+
+/* ---- "Action required" hub card (returned-for-edit drafts) ---------- */
+.option-card.drafts-card {
+  border-left: 4px solid #d97706;
+  background: linear-gradient(to right, rgba(217,119,6,0.04), transparent 40%);
+}
+.option-card.drafts-card:hover {
+  background: linear-gradient(to right, rgba(217,119,6,0.08), transparent 50%);
+}
+.drafts-icon { color: #d97706; }
+.card-badge.drafts-badge {
+  background: #d97706; color: #fff;
+  padding: 2px 9px; border-radius: 10px; font-size: 11px;
+  margin-left: 8px; font-weight: 700;
+}
+
+/* What-needs-to-change banner on the draft itself */
+.draft-banner {
+  background: #fef3c7;
+  border-left: 4px solid #d97706;
+  border-radius: 4px;
+  padding: 14px 18px;
+  margin: 0 0 18px;
+}
+.draft-banner .dbl {
+  font-family: 'JetBrains Mono', monospace;
+  font-size: 10px; letter-spacing: 0.08em;
+  text-transform: uppercase; color: #92400e;
+  margin-bottom: 6px; font-weight: 600;
+}
+.draft-banner .dbm {
+  font-size: 14px; color: var(--bsg-ink);
+  line-height: 1.55; white-space: pre-wrap;
+}
+.draft-banner .dbs {
+  font-size: 11px; color: #92400e;
+  margin-top: 8px;
+}
+
+/* ---- Folder-style admin tabs (Pending + All Submissions) ----------- */
+.employee-folders {
+  display: flex; flex-direction: column;
+  gap: 10px;
+}
+.emp-folder {
+  background: #fff;
+  border: 1px solid var(--bsg-line);
+  border-radius: 4px;
+  overflow: hidden;
+  transition: border-color 0.15s;
+}
+.emp-folder:hover { border-color: rgba(37,99,235,0.4); }
+.emp-folder-head {
+  display: flex; align-items: center; justify-content: space-between;
+  padding: 14px 18px;
+  cursor: pointer;
+  user-select: none;
+  transition: background 0.12s;
+}
+.emp-folder-head:hover { background: rgba(37,99,235,0.04); }
+.emp-folder.open .emp-folder-head {
+  border-bottom: 1px solid var(--bsg-line);
+  background: rgba(37,99,235,0.03);
+}
+.efh-left {
+  display: flex; align-items: center; gap: 10px;
+  min-width: 0; flex: 1;
+}
+.efh-caret {
+  display: inline-block;
+  font-size: 9px;
+  color: var(--bsg-muted);
+  transition: transform 0.15s;
+  width: 12px;
+  text-align: center;
+}
+.emp-folder.open .efh-caret { transform: rotate(90deg); }
+.efh-name {
+  font-weight: 600;
+  font-size: 14px;
+  color: var(--bsg-ink);
+}
+.efh-email {
+  font-family: 'JetBrains Mono', monospace;
+  font-size: 11px;
+  color: var(--bsg-muted);
+}
+.efh-right {
+  display: flex; align-items: center; gap: 12px;
+  flex-shrink: 0;
+}
+.efh-total {
+  font-family: 'JetBrains Mono', monospace;
+  font-size: 13px;
+  color: var(--bsg-ink);
+  font-weight: 600;
+}
+.efh-badge {
+  display: inline-block;
+  background: var(--bsg-blue);
+  color: #fff;
+  padding: 2px 9px;
+  border-radius: 10px;
+  font-size: 11px;
+  font-weight: 700;
+  min-width: 22px;
+  text-align: center;
+}
+.efh-badge.zero {
+  background: var(--bsg-muted);
+}
+.emp-folder-body {
+  display: none;
+  padding: 0;
+}
+.emp-folder.open .emp-folder-body { display: block; }
+.emp-no-match {
+  padding: 16px 18px;
+  font-size: 13px;
+  color: var(--bsg-muted);
+  font-style: italic;
+}
+.folder-table {
+  width: 100%;
+  margin: 0;
+  border: 0;
+}
+.folder-table thead th {
+  font-family: 'JetBrains Mono', monospace;
+  font-size: 10px;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  color: var(--bsg-muted);
+  font-weight: 600;
+  text-align: left;
+  padding: 8px 14px;
+  background: #fafbfc;
+  border-bottom: 1px solid var(--bsg-line);
+}
+.folder-table tbody td {
+  padding: 10px 14px;
+  border-bottom: 1px solid #f2f4f7;
+  font-size: 13px;
+  color: var(--bsg-ink);
+  vertical-align: middle;
+}
+.folder-table tbody tr:last-child td { border-bottom: 0; }
+.folder-table tbody tr:hover { background: rgba(37,99,235,0.03); }
+.empty-state {
+  text-align: center;
+  padding: 48px 24px;
+  color: var(--bsg-muted);
+  font-size: 14px;
+}
+
+/* ---- Payments tab ---------------------------------------------- */
+.pay-row-paid {
+  background: rgba(5,150,105,0.04);
+}
+.pay-row-paid:hover {
+  background: rgba(5,150,105,0.07);
+}
+.paid-summary {
+  display: flex;
+  justify-content: space-between;
+  align-items: flex-end;
+  background: linear-gradient(to right, rgba(37,99,235,0.06), transparent);
+  border-left: 4px solid var(--bsg-blue);
+  padding: 18px 22px;
+  border-radius: 4px;
+}
+.paid-summary .ps-label {
+  font-family: 'JetBrains Mono', monospace;
+  font-size: 10px;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  color: var(--bsg-muted);
+  margin-bottom: 4px;
+  font-weight: 600;
+}
+.paid-summary .ps-amount {
+  font-family: 'Oswald', sans-serif;
+  font-size: 28px;
+  color: var(--bsg-ink);
+  font-weight: 600;
+  line-height: 1;
+}
+.paid-summary .ps-count {
+  font-family: 'Oswald', sans-serif;
+  font-size: 22px;
+  color: var(--bsg-ink);
+  font-weight: 500;
+  line-height: 1;
+}
+.pay-already {
+  background: rgba(5,150,105,0.08);
+  border-left: 4px solid var(--bsg-success);
+  padding: 12px 16px;
+  border-radius: 3px;
+}
+
+/* ---- Period-lock banner ------------------------------------------ */
+.period-lock-banner {
+  border-radius: 4px;
+  padding: 14px 18px;
+  margin: 0 0 18px;
+}
+.period-lock-banner.locked {
+  background: #fef2f2;
+  border-left: 4px solid #dc2626;
+}
+.period-lock-banner.via-override {
+  background: #ecfdf5;
+  border-left: 4px solid #059669;
+}
+.period-lock-banner .plb-label {
+  font-family: 'JetBrains Mono', monospace;
+  font-size: 10px; letter-spacing: 0.08em;
+  text-transform: uppercase; font-weight: 600;
+  margin-bottom: 6px;
+}
+.period-lock-banner.locked .plb-label { color: #991b1b; }
+.period-lock-banner.via-override .plb-label { color: #065f46; }
+.period-lock-banner .plb-msg {
+  font-size: 13px;
+  color: var(--bsg-ink);
+  line-height: 1.55;
+}
diff --git a/app/static/expense/js/app.js b/app/static/expense/js/app.js
