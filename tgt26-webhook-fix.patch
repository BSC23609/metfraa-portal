+@router.get("/tgt26/wati-webhook")
+def wati_webhook_probe():
+    """Some dashboards validate a webhook URL with a GET before saving.
+    Answer politely instead of 405 so the URL can be registered."""
+    return {"ok": True, "hint": "WATI must POST message events here"}
+
+
+def _extract_text(data: dict) -> str:
+    """WATI payload shapes vary by event and tenant version. Quick-reply taps
+    have arrived as plain `text`, as type=button with `buttonText`, and nested
+    under interactive/button/listReply objects. Take the first non-empty."""
+    for v in (data.get("text"), data.get("buttonText"),
+              (data.get("button") or {}).get("text")
+              if isinstance(data.get("button"), dict) else None,
+              (data.get("interactiveButtonReply") or {}).get("title")
+              if isinstance(data.get("interactiveButtonReply"), dict) else None,
+              (data.get("listReply") or {}).get("title")
+              if isinstance(data.get("listReply"), dict) else None):
+        if v and str(v).strip():
+            return str(v).strip()
+    return ""
+
