+    now = _dt.utcnow().isoformat()
+    rows = (db.query(ExpensePeriodOverride)
+            .filter(ExpensePeriodOverride.revoked_at.is_(None),
+                    ExpensePeriodOverride.expires_at > now)
+            .order_by(ExpensePeriodOverride.id.desc()).all())
