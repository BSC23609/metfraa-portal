+/* Back to the portal home. Deliberate addition to the reference — the topbar
+   had no text-button style, only the 36px square .topbar-back. Matches that
+   button's border + hover-invert so it reads as native. */
+.topbar-home {
+  display: inline-flex;
+  align-items: center;
+  height: 36px;
+  padding: 0 12px;
+  border: 1px solid var(--bsg-line);
+  background: #fff;
+  color: var(--bsg-ink);
+  border-radius: 4px;
+  font-size: 12px;
+  font-weight: 600;
+  text-decoration: none;
+  white-space: nowrap;
+  cursor: pointer;
+  transition: all 0.18s ease;
+  flex-shrink: 0;
+}
+.topbar-home:hover {
+  background: var(--bsg-ink);
+  color: #fff;
+  border-color: var(--bsg-ink);
+}
