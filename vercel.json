{
  "regions": [
    "sin1"
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/cron/missed-day",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/cron/daily-task-report",
      "schedule": "35 4 * * *"
    },
    {
      "path": "/cron/gatepass-overdue",
      "schedule": "*/30 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/ehs/(css|js|img)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
