diff --git a/.github/workflows/gatepass-overdue.yml b/.github/workflows/gatepass-overdue.yml
index 8344cbc..1c23b2f 100644
--- a/.github/workflows/gatepass-overdue.yml
+++ b/.github/workflows/gatepass-overdue.yml
@@ -6,13 +6,18 @@ name: Gatepass overdue watcher
 # Not a Vercel cron: Hobby plans allow only one run per day, and a daily check is
 # useless for a pass due back at 3pm.
 #
+# Every 5 minutes, matching BSC's outpass watcher. With a 15-minute grace period
+# that means someone is chased 15-20 minutes after their in-time rather than up
+# to 30. GitHub's scheduler is best-effort and can lag under load, which is the
+# other reason for the short interval — a delayed run still lands soon enough.
+#
 # Retry + 5xx tolerance, same as the BSC watchers: the work is idempotent (each
 # recipient has its own stamp, and a stamp is only set once a channel actually
 # delivered), so a transient gateway hiccup or cold-start timeout is a warning, not
 # a failure. Real problems — bad CRON_SECRET (401), broken route (404) — fail loudly.
 on:
   schedule:
-    - cron: '*/15 * * * *'
+    - cron: '*/5 * * * *'
   workflow_dispatch: {}
 
 jobs:
