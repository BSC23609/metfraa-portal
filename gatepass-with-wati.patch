+                <td class="py-1.5 mono" x-text="r.phone"></td>
+                <td class="py-1.5" x-text="r.template"></td>
+                <td class="py-1.5">
+                  <span class="px-1.5 py-0.5 rounded text-[10px] font-bold"
+                        :class="r.result === 'sent' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-700'"
+                        x-text="r.result"></span>
+                </td>
+                <td class="py-1.5 text-metfraa-gray-500 truncate max-w-xs" x-text="r.detail"></td>
+              </tr>
+            </template>
+          </tbody>
+        </table>
+        <div x-show="!wa.rows.length" class="text-sm text-metfraa-gray-400 py-4">No sends logged yet.</div>
+      </div>
+    </div>
