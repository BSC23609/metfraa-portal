+
+<script>
+function gpApp() {
+  return {
+    tab: 'new', busy: false, msg: '', err: false,
+    mine: [], approvals: [], openPasses: [], depts: [], people: [], wa: { configured: false, hr_phone_set: false, counts: {}, rows: [] },
+    myApprover: null, pendingCount: {{ pending_for_me }},
+    isAdmin: {{ 'true' if is_admin else 'false' }},
+    form: { type: 'outpass', req_date: new Date().toISOString().slice(0, 10),
+            out_time: '', in_time: '', purpose: '', on_duty: false, manager_on_leave: false },
+
+    get tabs() {
+      const t = [{ id: 'new', label: 'New request' }, { id: 'mine', label: 'My passes' },
+                 { id: 'approvals', label: 'Approvals' }];
+      if (this.isAdmin) t.push({ id: 'admin', label: 'Admin' });
+      return t;
+    },
+
+    init() { this.load(); this.loadMine(); },
+
+    async load() {
+      if (this.tab === 'mine') return this.loadMine();
+      if (this.tab === 'approvals') return this.loadApprovals();
+      if (this.tab === 'admin') { await this.loadOpen(); await this.loadWa(); return this.loadDepts(); }
+    },
+
+    async loadMine() {
+      const r = await fetch('/gatepass/api/mine');
+      if (!r.ok) return;
+      const d = await r.json();
+      this.mine = d.requests || [];
+      this.myApprover = d.my_approver;
+    },
+    async loadApprovals() {
+      const r = await fetch('/gatepass/api/approvals');
+      if (!r.ok) return;
+      const d = await r.json();
+      this.approvals = d.requests || [];
+      this.pendingCount = d.pending || 0;
+    },
+    async loadOpen() {
+      const r = await fetch('/gatepass/api/admin/all?status=open');
+      if (r.ok) this.openPasses = (await r.json()).requests || [];
+    },
+    async loadWa() {
+      const r = await fetch('/gatepass/api/admin/wa-log');
+      if (r.ok) this.wa = await r.json();
+    },
+    async loadDepts() {
+      const r = await fetch('/gatepass/api/admin/approvers');
+      if (!r.ok) return;
+      const d = await r.json();
+      this.depts = d.departments || [];
+      this.people = d.employees || [];
+    },
+
+    statusLabel(o) {
+      if (o.status === 'pending') return 'Pending';
+      if (o.status === 'rejected') return 'Rejected';
+      if (o.returned_at) return 'Returned';
+      if (o.multi_day) return 'Multi-day';
+      if (o.overdue) return 'Overdue';
+      return 'Approved';
+    },
+    statusClass(o) {
+      const l = this.statusLabel(o);
+      return { Pending: 'bg-amber-100 text-amber-800', Rejected: 'bg-red-100 text-red-700',
+               Returned: 'bg-green-100 text-green-800', Overdue: 'bg-red-500 text-white',
+               'Multi-day': 'bg-metfraa-gray-200 text-metfraa-gray-600',
+               Approved: 'bg-metfraa-blue/10 text-metfraa-blue' }[l] || '';
+    },
+
+    async submit() {
+      this.busy = true; this.msg = ''; this.err = false;
+      try {
+        const r = await fetch('/gatepass/api/request', {
+          method: 'POST', headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(this.form),
+        });
+        const d = await r.json();
+        if (!r.ok) throw new Error(d.detail || 'Could not submit');
+        this.msg = `Sent to ${d.approver} · ${d.ref_no}`;
+        this.form.purpose = ''; this.form.out_time = ''; this.form.in_time = '';
+        this.loadMine();
+      } catch (e) { this.err = true; this.msg = e.message; }
+      finally { this.busy = false; }
+    },
+
+    async approve(o) {
+      if (!confirm(`Approve ${o.requester_name}'s ${o.type}?`)) return;
+      const r = await fetch(`/gatepass/api/${o.id}/approve`, { method: 'POST' });
+      if (!r.ok) { const d = await r.json().catch(() => ({})); alert(d.detail || 'Failed'); return; }
+      this.loadApprovals();
+    },
+    async reject(o) {
+      const reason = prompt('Why is this not approved? The employee will see this.');
+      if (!reason || reason.trim().length < 3) return;
+      const r = await fetch(`/gatepass/api/${o.id}/reject`, {
+        method: 'POST', headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ reason }),
+      });
+      if (!r.ok) { const d = await r.json().catch(() => ({})); alert(d.detail || 'Failed'); return; }
+      this.loadApprovals();
+    },
+    async recordReturn(o) {
+      const r = await fetch(`/gatepass/api/${o.id}/return`, { method: 'POST' });
+      if (!r.ok) { const d = await r.json().catch(() => ({})); alert(d.detail || 'Failed'); return; }
+      this.loadMine(); if (this.tab === 'admin') this.loadOpen();
+    },
+    async saveDept(d) {
+      const r = await fetch('/gatepass/api/admin/approvers', {
+        method: 'POST', headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ department: d.department, head_emp_id: d.head_emp_id || null,
+                               leave_cover_emp_id: d.leave_cover_emp_id || null, active: true }),
+      });
+      if (!r.ok) { const e = await r.json().catch(() => ({})); alert(e.detail || 'Failed'); return; }
+      this.loadDepts();
+    },
+  };
+}
+</script>
+{% endblock %}
