+        </tbody>
+      </table>
+    </div>
+
+    <div class="bg-white rounded-lg ring-1 ring-metfraa-gray-200 p-5">
+      <div class="lbl mb-1">Department approvers</div>
+      <p class="text-xs text-metfraa-gray-500 mb-4">
+        Who approves passes for each department. Leave cover is used when a requester
+        ticks "my manager is on leave".
+      </p>
+      <table class="w-full text-sm">
+        <thead>
+          <tr class="text-left lbl border-b border-metfraa-gray-100">
+            <th class="py-2">Department</th><th class="py-2">Approver</th>
+            <th class="py-2">Leave cover</th><th></th>
+          </tr>
+        </thead>
+        <tbody class="divide-y divide-metfraa-gray-100">
+          <template x-for="d in depts" :key="d.department">
+            <tr>
+              <td class="py-2 font-semibold" x-text="d.department"></td>
+              <td class="py-2">
+                <select x-model="d.head_emp_id" class="text-xs rounded border-metfraa-gray-300 w-full">
+                  <option :value="null">— none —</option>
+                  <template x-for="e in people" :key="e.id">
+                    <option :value="e.id" x-text="e.name"></option>
+                  </template>
+                </select>
+              </td>
+              <td class="py-2">
+                <select x-model="d.leave_cover_emp_id" class="text-xs rounded border-metfraa-gray-300 w-full">
+                  <option :value="null">— none —</option>
