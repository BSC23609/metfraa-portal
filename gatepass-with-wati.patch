+        <div class="text-sm text-metfraa-gray-400 py-4">Nothing outstanding.</div>
+      </template>
+      <table x-show="openPasses.length" class="w-full text-sm">
+        <thead>
+          <tr class="text-left lbl border-b border-metfraa-gray-100">
+            <th class="py-2">Employee</th><th class="py-2">Ref</th>
+            <th class="py-2">Out</th><th class="py-2">Due back</th><th class="py-2">Status</th><th></th>
+          </tr>
+        </thead>
+        <tbody class="divide-y divide-metfraa-gray-100">
+          <template x-for="o in openPasses" :key="o.id">
+            <tr>
+              <td class="py-2">
+                <div class="font-semibold" x-text="o.requester_name"></div>
+                <div class="text-xs text-metfraa-gray-500" x-text="o.department"></div>
+              </td>
+              <td class="py-2 mono text-xs" x-text="o.ref_no"></td>
+              <td class="py-2 text-xs" x-text="o.req_date + ' ' + (o.out_time || '')"></td>
+              <td class="py-2 text-xs" x-text="o.expected_back_at || '—'"></td>
+              <td class="py-2">
+                <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase"
+                      :class="statusClass(o)" x-text="statusLabel(o)"></span>
+              </td>
+              <td class="py-2 text-right">
+                <button @click="recordReturn(o)"
+                  class="px-2 py-1 rounded ring-1 ring-metfraa-gray-300 text-xs font-bold">Mark returned</button>
