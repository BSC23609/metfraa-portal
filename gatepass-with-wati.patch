+
+  <!-- ============ ADMIN ============ -->
+  <div x-show="tab === 'admin'">
+    <div class="bg-white rounded-lg ring-1 ring-metfraa-gray-200 p-5 mb-5">
+      <div class="flex items-center justify-between flex-wrap gap-2 mb-3">
+        <div>
+          <div class="lbl">WhatsApp delivery</div>
