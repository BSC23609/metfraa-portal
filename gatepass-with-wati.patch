@@ -0,0 +1,437 @@
+{% extends "base.html" %}
+{% block title %}Outpass / Gatepass — Metfraa{% endblock %}
+
+{% block content %}
+<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8" x-data="gpApp()" x-init="init()" x-cloak>
+
+  <div class="mb-8">
+    <div class="lbl mb-2">Metfraa Portal</div>
+    <h1 class="display display-xl text-4xl text-metfraa-ink leading-none">Outpass / Gatepass</h1>
+    <div class="flex items-center gap-3 mt-3">
+      <span class="h-px w-10 bg-metfraa-blue"></span>
+      <p class="text-sm text-metfraa-gray-500">
+        Outpass — leaving, no return today. Gatepass — out and back the same day.
+      </p>
+    </div>
+  </div>
+
+  <!-- Tabs -->
+  <div class="flex gap-1 mb-6 border-b border-metfraa-gray-200 flex-wrap">
+    <template x-for="t in tabs" :key="t.id">
+      <button @click="tab = t.id; load()"
+        :class="tab === t.id
+          ? 'border-metfraa-blue text-metfraa-ink'
+          : 'border-transparent text-metfraa-gray-500 hover:text-metfraa-ink'"
+        class="px-4 py-2 text-sm font-bold border-b-2">
+        <span x-text="t.label"></span>
+        <span x-show="t.id === 'approvals' && pendingCount > 0"
+              class="ml-1 px-1.5 py-0.5 rounded-full bg-red-500 text-white text-[10px]"
+              x-text="pendingCount"></span>
+      </button>
+    </template>
+  </div>
+
+  <!-- ============ NEW REQUEST ============ -->
+  <div x-show="tab === 'new'">
+    <div class="bg-white rounded-lg ring-1 ring-metfraa-gray-200 p-6 max-w-2xl">
+      <div class="lbl mb-4">New request</div>
+
+      <div class="grid grid-cols-2 gap-3 mb-5">
+        <template x-for="t in ['outpass','gatepass']" :key="t">
+          <button @click="form.type = t"
+            :class="form.type === t
+              ? 'border-metfraa-blue bg-metfraa-blue/5 text-metfraa-ink'
+              : 'border-metfraa-gray-200 text-metfraa-gray-500 hover:border-metfraa-gray-300'"
+            class="border-2 rounded-lg p-4 text-left">
+            <div class="display text-sm font-bold" x-text="t === 'outpass' ? 'Outpass' : 'Gatepass'"></div>
+            <div class="text-xs mt-1 text-metfraa-gray-500"
+                 x-text="t === 'outpass' ? 'Leaving — not returning today' : 'Out and back — declares an in-time'"></div>
+          </button>
+        </template>
+      </div>
+
+      <div class="grid sm:grid-cols-2 gap-4">
+        <div>
+          <label class="lbl block mb-1">Date</label>
+          <input type="date" x-model="form.req_date"
+                 class="w-full rounded-lg border-metfraa-gray-300 text-sm">
+        </div>
+        <div>
+          <label class="lbl block mb-1">Out time</label>
+          <input type="time" x-model="form.out_time"
+                 class="w-full rounded-lg border-metfraa-gray-300 text-sm">
+        </div>
+        <div x-show="form.type === 'gatepass'">
+          <label class="lbl block mb-1">Expected in time</label>
+          <input type="time" x-model="form.in_time"
+                 class="w-full rounded-lg border-metfraa-gray-300 text-sm">
+        </div>
+      </div>
+
+      <div class="mt-4">
+        <label class="lbl block mb-1">Purpose</label>
+        <textarea x-model="form.purpose" rows="3" maxlength="2000"
+                  placeholder="Where you're going and why"
+                  class="w-full rounded-lg border-metfraa-gray-300 text-sm"></textarea>
+      </div>
+
+      <div class="mt-4 space-y-2">
+        <label class="flex items-center gap-2 text-sm">
