+def _draw_logos(c):
+    """Group logo (left) + Metfraa logo (right) at the top — matches the
+    individual claim headers so the cover is branded too."""
+    top = 30
+    try:
+        g = ImageReader(GROUP_LOGO); gw, gh = g.getSize(); h = 22
+        c.drawImage(g, 50, PAGE_H - top - h, width=h * gw / gh, height=h, mask="auto")
+    except Exception:
+        pass
+    co = COMPANY_LOGOS.get("metfraa")
+    if co:
+        try:
+            im = ImageReader(co); iw, ih = im.getSize()
+            bw, bh = 110, 26; sc = min(bw / iw, bh / ih); w, hh = iw * sc, ih * sc
+            c.drawImage(im, PAGE_W - 50 - w, PAGE_H - top - hh, width=w, height=hh, mask="auto")
+        except Exception:
+            pass
