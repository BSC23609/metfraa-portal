+def _bill_band_pdf(idx, total, label, meta):
+    """A one-page overlay: 'BILL n OF m' + label + meta at the top of a PDF-bill
+    page, plus the HOME pill. Matches the image-bill header style."""
+    buf = io.BytesIO()
+    c = _canvas.Canvas(buf, pagesize=A4)
+    W, H = PAGE_W, PAGE_H
+    c.setFont(_font(bold=True), 8); c.setFillColor(_hex(MUTED))
+    c.setCharSpace = None
+    c.drawString(50, H - 44, f"BILL {idx} OF {total}")
+    c.setFont(_font(bold=True), 13); c.setFillColor(_hex(INK))
+    c.drawString(50, H - 62, (label or "Bill")[:90])
+    c.setFont(_font(), 9); c.setFillColor(_hex(MUTED))
+    c.drawString(50, H - 78, meta)
+    # HOME pill
+    lab = "HOME ^"
+    pw = pdfmetrics.stringWidth(lab, _font(bold=True), 8) + 16
+    x = W - MARGIN - pw; y = H - MARGIN + 4
+    c.setFillColor(_hex(SOFT)); c.setStrokeColor(_hex(LINE)); c.setLineWidth(0.5)
+    c.roundRect(x, y, pw, 16, 2, fill=1, stroke=1)
+    c.setFillColor(_hex(BLUE)); c.setFont(_font(bold=True), 8)
+    c.drawString(x + 8, y + 4.5, lab)
+    c.save()
+    return buf.getvalue(), [x, y, x + pw, y + 16]
