+log = logging.getLogger(__name__)
+
+
+# The startup migration that creates password_otps only runs on Vercel when
+# INIT_DB is set (see main.lifespan), so we can't assume the table exists.
+# This ensures it on demand — idempotent, cached after the first success per
+# warm instance. SQLAlchemy emits the right CREATE TABLE for whichever dialect
+# (Postgres in prod, SQLite in local dev) and checkfirst=True makes it a no-op
+# when the table is already there — so no Postgres-only DDL to trip on SQLite.
+_OTP_TABLE_READY = False
+
+
+def _ensure_otp_table(db: Session) -> None:
+    global _OTP_TABLE_READY
+    if _OTP_TABLE_READY:
+        return
+    try:
+        PasswordOtp.__table__.create(bind=db.get_bind(), checkfirst=True)
+        _OTP_TABLE_READY = True
+    except Exception:
+        try:
+            db.rollback()
+        except Exception:
+            pass
+        log.warning("[auth] ensure password_otps table failed", exc_info=True)
 
 
 DEFAULT_PASSWORD = "Metfraa@123"
